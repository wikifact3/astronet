NODE_ENV=staging
APP_NAME=PowerLink API (Staging)
PORT=8080
CORS_ORIGINS=https://staging.powerlink.com.np

# Use stronger secrets in staging
JWT_SECRET=staging-jwt-secret-change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

OTP_EXPIRES_IN=300
OTP_RATE_LIMIT=5

DB_HOST=postgres-staging.internal
DB_PORT=5432
DB_USERNAME=powerlink_user
DB_PASSWORD=staging-db-password-change-me
DB_NAME=powerlink_core_staging

TSDB_HOST=timescaledb-staging.internal
TSDB_PORT=5432
TSDB_USERNAME=powerlink_user
TSDB_PASSWORD=staging-db-password-change-me
TSDB_NAME=powerlink_telemetry_staging

REDIS_HOST=redis-staging.internal
REDIS_PORT=6379
REDIS_PASSWORD=staging-redis-password-change-me

ESEWA_ENVIRONMENT=sandbox
KHALTI_ENVIRONMENT=sandbox
