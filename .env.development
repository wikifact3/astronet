# Application
NODE_ENV=development
APP_NAME=PowerLink API
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# OTP Configuration
OTP_EXPIRES_IN=300
OTP_RATE_LIMIT=5

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=powerlink_core

# TimescaleDB (Telemetry)
TSDB_HOST=localhost
TSDB_PORT=5433
TSDB_USERNAME=postgres
TSDB_PASSWORD=postgres
TSDB_NAME=powerlink_telemetry

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Payment Providers (eSewa)
ESEWA_MERCHANT_ID=your-esewa-merchant-id
ESEWA_SECRET_KEY=your-esewa-secret-key
ESEWA_ENVIRONMENT=sandbox
ESEWA_REDIRECT_URL=http://localhost:3000/payment/callback

# Payment Providers (Khalti)
KHALTI_SECRET_KEY=your-khalti-secret-key
KHALTI_ENVIRONMENT=sandbox
KHALTI_REDIRECT_URL=http://localhost:3000/payment/callback

# SMS Gateway
SMS_PROVIDER_API_KEY=your-sms-api-key
SMS_PROVIDER_SENDER_ID=PowerLink

# RADIUS/OLT
RADIUS_HOST=localhost
RADIUS_PORT=1812
RADIUS_SECRET=your-radius-secret
OLT_API_URL=http://localhost:8080/api

# IRD (Phase 2)
IRD_API_URL=https://cbms.ird.gov.np/api
IRD_CLIENT_ID=your-ird-client-id
IRD_CLIENT_SECRET=your-ird-client-secret

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=powerlink-assets

# Observability
LOKI_URL=http://localhost:3100
PROMETHEUS_URL=http://localhost:9090
OTEL_COLLECTOR_URL=http://localhost:4318
