NODE_ENV=production
APP_NAME=PowerLink API
PORT=8080
CORS_ORIGINS=https://powerlink.com.np,https://portal.powerlink.com.np

# Must be changed to secure secrets in production
JWT_SECRET=change-this-to-secure-production-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

OTP_EXPIRES_IN=300
OTP_RATE_LIMIT=5

DB_HOST=postgres-production.internal
DB_PORT=5432
DB_USERNAME=powerlink_prod
DB_PASSWORD=change-to-secure-production-password
DB_NAME=powerlink_core_production

TSDB_HOST=timescaledb-production.internal
TSDB_PORT=5432
TSDB_USERNAME=powerlink_prod
TSDB_PASSWORD=change-to-secure-production-password
TSDB_NAME=powerlink_telemetry_production

REDIS_HOST=redis-production.internal
REDIS_PORT=6379
REDIS_PASSWORD=change-to-secure-production-password

ESEWA_ENVIRONMENT=production
KHALTI_ENVIRONMENT=production
